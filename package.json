{
  "name": "privsearch",
  "version": "0.1.0",
  "description": "Privacy-focused desktop research browser with built-in search engine",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build": "tsc && mkdir -p dist/db dist/renderer && cp src/db/schema.sql dist/db/ && cp src/renderer/index.html dist/renderer/",
    "build:watch": "tsc --watch",
    "start": "npm run build && electron dist/main/index.js",
    "dev": "concurrently \"tsc --watch\" \"electron dist/main/index.js\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "privacy",
    "browser",
    "search",
    "dork",
    "osint",
    "infosec"
  ],
  "author": "PrivSearch",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0"
  },
  "build": {
    "appId": "io.privsearch.app",
    "productName": "PrivSearch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleNameMapper": {
      "^electron$": "<rootDir>/tests/__mocks__/electron.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}